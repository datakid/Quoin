+    expect(got.bytesLength).toBe(expected.bytesLength);
+    return;
+  }
+  expect(got.bytes.length).toBeGreaterThan(0);
+  expect(await zipDigest(got.bytes)).toEqual(await zipDigest(expected.bytes));
+}
